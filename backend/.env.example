# Environment variables for ReturnWise AI Backend
# Copy this to .env and fill in your actual values — NEVER commit .env

GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development

# AWS configuration — If left empty, application runs in offline Local Mode automatically!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=returnwise-ai-assets
DYNAMODB_TABLE_PREFIX=returnwise_ai_
